{
  "name": "Pocket Hell — Handheld Raycaster",
  "short_name": "Pocket Hell",
  "description": "A playable retro raycasting FPS built with TypeScript and Canvas 2D.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#080b09",
  "theme_color": "#0a0d0b",
  "categories": [
    "games",
    "education",
    "developer tools"
  ],
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Play Pocket Hell",
      "short_name": "Play",
      "url": "./#play"
    },
    {
      "name": "View Leaderboard",
      "short_name": "Scores",
      "url": "./?scores=1"
    }
  ]
}
